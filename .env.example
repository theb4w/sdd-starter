# Template de variáveis de ambiente.
# 
# 1. Copie para .env: cp .env.example .env
# 2. Preencha valores reais.
# 3. NUNCA commite .env (já está no .gitignore).
# 4. Em produção, use Secret Manager / Vault / equivalente.

# ─── Aplicação ───────────────────────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# ─── Cloud Provider (exemplo GCP — ajuste à sua stack) ───────────────────────
# GCP_PROJECT_ID=
# GCP_REGION=
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# ─── Banco de dados ──────────────────────────────────────────────────────────
# DATABASE_URL=

# ─── Auth / Secrets ──────────────────────────────────────────────────────────
# API_KEY=
# JWT_SECRET=

# ─── Integrações externas ────────────────────────────────────────────────────
# OPENAI_API_KEY=
# GEMINI_API_KEY=
