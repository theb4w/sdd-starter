# Build context para `gcloud builds submit` / `gcloud run deploy`.
# Mantenha enxuto: tudo que não roda em produção fora.
# Sem isso, Cloud Build envia 100s de MB inúteis (.venv, .git, docs, tests).
# 
# Nota: este arquivo segue o template do sdd-starter. Ajuste à sua stack.
# Stack atual: <!-- ADAPT: gcp | aws | azure | none -->

# ─── Git ─────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ─── Docs e specs (não fazem parte do build) ─────────────────────────────────
docs/
specs/
QUICKSTART/
prompts/
README.md
LICENSE
AGENTS.md
GEMINI.md
PROJECT_BRIEF.md
.agent/

# ─── Testes ──────────────────────────────────────────────────────────────────
tests/
pytest.ini
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ─── Ambientes virtuais ──────────────────────────────────────────────────────
.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]

# ─── Secrets (defesa em profundidade — .gitignore já protege) ────────────────
.env
.env.local
*.key
service-account*.json
credentials*.json

# ─── Editor / IDE ────────────────────────────────────────────────────────────
.vscode/
.idea/
.cursor/
*.swp
.DS_Store

# ─── Cloud / IaC ─────────────────────────────────────────────────────────────
.terraform/
*.tfstate*
